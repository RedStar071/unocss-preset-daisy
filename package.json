{
	"name": "@redstar071/unocss-preset-daisy",
	"version": "1.2.0",
	"description": "UnoCSS preset for daisyUI",
	"keywords": [
		"css",
		"daisyui",
		"preset",
		"tailwind",
		"unocss"
	],
	"homepage": "https://redstar071.github.io/unocss-preset-daisy/",
	"bugs": {
		"url": "https://github.com/RedStar071/unocss-preset-daisy/issues"
	},
	"license": "MIT",
	"author": "Axel Meinhardt <axel.meinhardt@itiergarten.de> (https://www.itiergarten.de/)",
	"contributors": [
		"RedStar <redstar071@proton.me>"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RedStar071/unocss-preset-daisy.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"build:demo": "vite build demo",
		"changeset": "changeset add",
		"dev": "vite dev demo",
		"knip": "knip",
		"lint": "oxlint --type-aware && oxfmt --check .",
		"lint:fix": "oxlint --type-aware --fix && oxfmt --write .",
		"prepack": "pnpm run build",
		"preview": "vite preview demo --host",
		"publish": "pnpm run build && changeset publish",
		"start": "vite demo --host",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"postcss": "^8.5.6",
		"postcss-nested": "^7.0.2"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@iconify-json/octicon": "^1.2.6",
		"@types/node": "^22.15.29",
		"@unocss/reset": "^66.8.1",
		"@vitest/coverage-v8": "^4.1.11",
		"daisyui": "^5.7.20",
		"knip": "^6.32.2",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2001",
		"pkg-pr-new": "^0.0.88",
		"publint": "^0.3.24",
		"tsdown": "^0.22.14",
		"typescript": "~5.9.3",
		"unocss": "^66.8.1",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"daisyui": "^4.12.14 || >=5.0.24",
		"unocss": "^66.1.2"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24"
	},
	"packageManager": "pnpm@10.5.2"
}
